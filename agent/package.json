{
  "name": "agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-trust application channel peer agent — single binary CLI: run/setup/wizard/uninstall (config, bootstrap claim, setup UI).",
  "scripts": {
    "start": "bun run src/cli.ts run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:arm64": "bun build --compile --target=bun-linux-arm64 src/cli.ts --outfile dist/agent-arm64",
    "build:x64": "bun build --compile --target=bun-linux-x64 src/cli.ts --outfile dist/agent-x64"
  },
  "dependencies": {
    "jose": "^5.0.0",
    "zero-trust-application-channel": "^1.0.0"
  }
}
